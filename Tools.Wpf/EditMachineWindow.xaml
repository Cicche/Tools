<Window x:Class="Tools.Wpf.EditMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit PC" Height="360" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Categoria</TextBlock>
        <ComboBox Grid.Row="0" Grid.Column="1" Name="CmbCategory" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Nome macchina</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Name="TxtName" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">IP</TextBlock>
        <TextBox Grid.Row="2" Grid.Column="1" Name="TxtIp" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">User</TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Name="TxtUser" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Password</TextBlock>
        <PasswordBox Grid.Row="4" Grid.Column="1" Name="TxtPassword" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center">Conferma</TextBlock>
        <PasswordBox Grid.Row="5" Grid.Column="1" Name="TxtConfirmPassword" Margin="0,0,0,8" PasswordChanged="TxtConfirmPassword_OnPasswordChanged"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Name="LblValidation" Foreground="#B00020" FontWeight="SemiBold"/>

        <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Left"
                    Background="#B00020"
                    Foreground="White"
                    FontWeight="Bold"
                    ToolTip="Elimina macchina"
                    Click="Delete_Click">X</Button>
            <Button Grid.Column="1" Width="90" Margin="0,0,8,0" Click="Cancel_Click">Annulla</Button>
            <Button Grid.Column="2" Width="90" Click="Confirm_Click">Salva</Button>
        </Grid>
    </Grid>
</Window>
